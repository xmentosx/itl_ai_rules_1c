{
  "description": "Ensure standalone 1C rules; inspect ITL-managed projects without session-time installation or update.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/invoke-install.sh\" ensure claude-code"
          }
        ]
      }
    ]
  }
}
